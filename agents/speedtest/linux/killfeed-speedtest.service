[Unit]
Description=Killfeed speedtest agent (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/killfeed/speedtest-agent/speedtest-agent.sh /opt/killfeed/speedtest-agent/speedtest-agent.json
Nice=10
PrivateTmp=yes
ProtectHome=yes
# Runs as root by default so it can read the token file and send ICMP.
# To run unprivileged, create a user that owns the config and set User= here;
# add AmbientCapabilities=CAP_NET_RAW if ping then fails under systemd.
